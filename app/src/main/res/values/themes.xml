<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.CatatanHarian" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Toolbar transparan: ikon dan teks gelap di mode terang -->
    <style name="Theme.CatatanHarian.Toolbar" parent="ThemeOverlay.AppCompat.Light" />

    <!-- Popup menu titik tiga: teks gelap di mode terang -->
    <style name="Theme.CatatanHarian.Popup" parent="ThemeOverlay.AppCompat.Light" />

    <style name="TextAppearance.CatatanHarian.Title" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.CatatanHarian.Subtitle" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

</resources>
